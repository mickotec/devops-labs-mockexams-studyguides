#!/usr/bin/env bash
# ==============================================================================
# DevOps Labs & Mock Exams: Unified Launcher
# Dispatches commands to dedicated cka/lab or lfcs/lab orchestrators.
# ==============================================================================
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

function banner() {
  echo -e "${CYAN}${BOLD}"
  echo "╔════════════════════════════════════════════════════════════════════╗"
  echo "║                 DevOps Lab & Mock Exam Launcher                    ║"
  echo "║        Each exam track is independently managed in its folder:     ║"
  echo "║          • CKA Track:  cd cka  && ./lab                            ║"
  echo "║          • LFCS Track: cd lfcs && ./lab                            ║"
  echo "╚════════════════════════════════════════════════════════════════════╝"
  echo -e "${NC}"
}

function usage() {
  banner
  echo -e "${BOLD}USAGE:${NC}"
  echo "  ./lab cka [cmd...]         Forward command to CKA orchestrator (cka/lab)"
  echo "  ./lab lfcs [cmd...]        Forward command to LFCS orchestrator (lfcs/lab)"
  echo "  ./lab list [filter]        List all labs across both CKA and LFCS"
  echo "  ./lab start <lab-id>       Start a lab (auto-routes to cka or lfcs)"
  echo "  ./lab show <lab-id>        Display scenario questions (auto-routes)"
  echo "  ./lab check <lab-id>       Grade a solution (auto-routes to cka or lfcs)"
  echo "  ./lab solve <lab-id>       Display official solution (auto-routes)"
  echo "  ./lab reset <lab-id>       Clean up lab artifacts (auto-routes)"
  echo "  ./lab vm [status|start|stop] Manage all lab VirtualBox VMs"
  echo "  ./lab ssh <target>         Connect to controlplane, node01, node02, or lfcs"
  echo ""
  echo -e "${BOLD}DEDICATED DIRECTORIES:${NC}"
  echo "  For an isolated experience, work directly inside the track folder:"
  echo -e "    ${YELLOW}cd cka  && ./lab list${NC}"
  echo -e "    ${YELLOW}cd lfcs && ./lab list${NC}"
  exit 0
}

CMD="${1:-help}"

case "$CMD" in
  cka)
    shift || true
    exec "${SCRIPT_DIR}/cka/lab" "$@"
    ;;
  lfcs)
    shift || true
    exec "${SCRIPT_DIR}/lfcs/lab" "$@"
    ;;
  list|ls)
    shift || true
    filter="${1:-}"
    if [[ "$filter" =~ cka ]]; then
      exec "${SCRIPT_DIR}/cka/lab" list "$filter"
    elif [[ "$filter" =~ lfcs ]]; then
      exec "${SCRIPT_DIR}/lfcs/lab" list "$filter"
    else
      "${SCRIPT_DIR}/cka/lab" list "$filter"
      echo ""
      "${SCRIPT_DIR}/lfcs/lab" list "$filter"
    fi
    ;;
  start|show|check|verify|grade|solve|solution|reset|clean)
    LAB_ID="${2:-}"
    if [ -z "$LAB_ID" ]; then
      echo -e "${RED}[ERROR] Missing lab-id.${NC} Example: ./lab $CMD w1d1-cka"
      exit 1
    fi
    if [[ "$LAB_ID" =~ -lfcs ]]; then
      exec "${SCRIPT_DIR}/lfcs/lab" "$@"
    elif [[ "$LAB_ID" =~ -cka ]]; then
      exec "${SCRIPT_DIR}/cka/lab" "$@"
    else
      if [ -d "${SCRIPT_DIR}/cka/${LAB_ID}" ]; then
        exec "${SCRIPT_DIR}/cka/lab" "$@"
      elif [ -d "${SCRIPT_DIR}/lfcs/${LAB_ID}" ]; then
        exec "${SCRIPT_DIR}/lfcs/lab" "$@"
      else
        echo -e "${RED}[ERROR] Lab '${LAB_ID}' not found in cka/ or lfcs/.${NC}"
        exit 1
      fi
    fi
    ;;
  vm)
    shift || true
    action="${1:-status}"
    echo -e "${BOLD}--- CKA Kubernetes VMs ---${NC}"
    "${SCRIPT_DIR}/cka/lab" vm "$action"
    echo -e "${BOLD}--- LFCS Linux VM ---${NC}"
    "${SCRIPT_DIR}/lfcs/lab" vm "$action"
    ;;
  ssh)
    shift || true
    target="${1:-controlplane}"
    if [[ "$target" == "lfcs" || "$target" == "ubuntu" ]]; then
      exec "${SCRIPT_DIR}/lfcs/lab" ssh
    else
      exec "${SCRIPT_DIR}/cka/lab" ssh "$target"
    fi
    ;;
  help|*)
    usage
    ;;
esac
