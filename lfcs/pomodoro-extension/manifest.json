{
  "manifest_version": 3,
  "name": "LFCS Study Pomodoro Timer",
  "version": "1.2.0",
  "description": "Dedicated Pomodoro study timer for Linux Foundation Certified System Administrator (LFCS) exam preparation with audio chimes, settings, history tracking, and notifications.",
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "contextMenus",
    "offscreen",
    "tabs"
  ],
  "action": {
    "default_title": "LFCS Pomodoro Study Timer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["audio/*", "offscreen.html", "options.html", "options.js", "history.html", "history.js"],
      "matches": ["<all_urls>"]
    }
  ]
}