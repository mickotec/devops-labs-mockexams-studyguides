#!/usr/bin/env bash
# ==============================================================================
# LFCS Daily Hands-on Lab Orchestrator
# Designed for Ubuntu LFCS Virtual Machine
# ==============================================================================
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# VM Configuration
LFCS_VM="LFCS"

function banner() {
  echo -e "${CYAN}${BOLD}"
  echo "╔════════════════════════════════════════════════════════════════════╗"
  echo "║               LFCS Daily Hands-on Practice Orchestrator            ║"
  echo "║               Targeting: Ubuntu LFCS Virtual Machine               ║"
  echo "╚════════════════════════════════════════════════════════════════════╝"
  echo -e "${NC}"
}

function usage() {
  banner
  echo -e "${BOLD}USAGE:${NC}"
  echo "  ./lab list                 List all 48 LFCS daily labs and 4 mock exams"
  echo "  ./lab start <lab-id>       Inject lab scenario environment & display task"
  echo "  ./lab show <lab-id>        Display scenario questions & acceptance criteria"
  echo "  ./lab check <lab-id>       Verify and grade your LFCS lab solution"
  echo "  ./lab solve <lab-id>       Display official walkthrough & solution"
  echo "  ./lab reset <lab-id>       Clean up lab artifacts and restore clean state"
  echo "  ./lab exam [mock-id]       Launch interactive LFCS PSI exam simulator (webapp)"
  echo "  ./lab guide [day-id]       Generate LFCS daily study guide HTML (e.g. w1d1)"
  echo "  ./lab calendar             Interactively customize study start date & duration"
  echo "  ./lab todo                 Interactive terminal checklist for LFCS study plan"
  echo "  ./lab vm [status|start|stop] Manage LFCS VirtualBox VM"
  echo "  ./lab ssh                  Connect to LFCS Ubuntu VM"
  echo ""
  echo -e "${BOLD}EXAMPLES:${NC}"
  echo "  ./lab list"
  echo "  ./lab start w1d1-lfcs"
  echo "  ./lab check w1d1-lfcs"
  echo "  ./lab solve w1d1-lfcs"
  echo "  ./lab vm status"
  echo "  ./lab ssh"
  exit 0
}

function find_lab_dir() {
  local id="$1"
  if [ -d "${SCRIPT_DIR}/${id}" ]; then
    echo "${SCRIPT_DIR}/${id}"
  else
    echo ""
  fi
}

function list_labs() {
  local filter="${1:-}"
  banner
  if [ -n "$filter" ]; then
    echo -e "${BOLD}LFCS LAB SCENARIOS (Filter: ${filter}):${NC}"
  else
    echo -e "${BOLD}LFCS LAB SCENARIOS (Weeks 1 - 8 & Mock Exams):${NC}"
  fi
  printf "${CYAN}%-12s %-6s %-12s %-6s %-11s %-36s${NC}\n" "LAB ID" "TRACK" "DATE" "TIME" "DIFF" "TOPIC"
  echo "─────────────────────────────────────────────────────────────────────────────"

  for lab in $(ls -d "${SCRIPT_DIR}"/w*-lfcs "${SCRIPT_DIR}"/mock-lfcs-* 2>/dev/null | sort -V); do
    local id="$(basename "$lab")"
    if [ -n "$filter" ]; then
      if ! echo "$id" | grep -qi "$filter"; then
        continue
      fi
    fi
    local meta_file="${lab}/meta.env"
    if [ -f "$meta_file" ]; then
      source "$meta_file"
      local diff_short="${DIFFICULTY%% (*}"
      printf "%-12s %-6s %-12s %-6s %-11s %-36s\n" "$id" "${TRACK:-LFCS}" "${DATE:-}" "${TIME_LIMIT:-30m}" "${diff_short:-Medium}" "${TITLE:-}"
    else
      printf "%-12s %-6s %-12s %-6s %-11s %-36s\n" "$id" "LFCS" "-" "-" "-" "Scenario directory exists"
    fi
  done
  echo "─────────────────────────────────────────────────────────────────────────────"
  echo -e "Tip: Filter with ${YELLOW}./lab list w2${NC} or start with ${YELLOW}./lab start <lab-id>${NC}."
}

function vm_manager() {
  local action="${1:-status}"
  case "$action" in
    status)
      echo -e "${BOLD}VirtualBox LFCS Lab VM Status:${NC}"
      vboxmanage list vms | while read -r line; do
        vm_name=$(echo "$line" | cut -d'"' -f2)
        if [[ "$vm_name" == "LFCS" ]]; then
          state=$(vboxmanage showvminfo "$vm_name" --machinereadable | grep "VMState=" | cut -d'"' -f2)
          if [ "$state" == "running" ]; then
            echo -e "  $vm_name: ${GREEN}${BOLD}RUNNING${NC}"
          else
            echo -e "  $vm_name: ${YELLOW}${state}${NC}"
          fi
        fi
      done
      ;;
    start)
      echo -e "${BLUE}[*] Starting LFCS VM in headless mode...${NC}"
      state=$(vboxmanage showvminfo "LFCS" --machinereadable 2>/dev/null | grep "VMState=" | cut -d'"' -f2 || echo "not_found")
      if [ "$state" != "running" ] && [ "$state" != "not_found" ]; then
        vboxmanage startvm "LFCS" --type headless || true
      else
        echo -e "LFCS VM is already $state."
      fi
      ;;
    stop)
      echo -e "${YELLOW}[*] Gracefully stopping LFCS VM...${NC}"
      state=$(vboxmanage showvminfo "LFCS" --machinereadable 2>/dev/null | grep "VMState=" | cut -d'"' -f2 || echo "not_found")
      if [ "$state" == "running" ]; then
        vboxmanage controlvm "LFCS" acpipowerbutton || true
      fi
      ;;
    *)
      echo "Unknown vm command: $action (use: status, start, stop)"
      ;;
  esac
}

function ssh_shortcut() {
  ssh -i ~/.ssh/id_lab student@172.16.16.16 "$@"
}

function execute_lab_script() {
  local lab_id="$1"
  local script_path="$2"

  if [ ! -f "$script_path" ]; then
    return 0
  fi
  ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null lfcs 'bash -s' < "$script_path"
}

CMD="${1:-help}"

case "$CMD" in
  list|ls)
    list_labs "${2:-}"
    ;;
  start)
    LAB_ID="${2:-}"
    if [ -z "$LAB_ID" ]; then
      echo -e "${RED}[ERROR] Missing lab-id.${NC} Example: ./lab start w1d1-lfcs"
      exit 1
    fi
    TARGET_DIR="$(find_lab_dir "$LAB_ID")"
    if [ -z "$TARGET_DIR" ] || [ ! -d "$TARGET_DIR" ]; then
      echo -e "${RED}[ERROR] Lab '${LAB_ID}' not found.${NC}"
      exit 1
    fi
    echo -e "${BLUE}[*] Initializing LFCS scenario ${BOLD}${LAB_ID}${NC} on VM..."
    if [ -f "${TARGET_DIR}/setup.sh" ]; then
      execute_lab_script "$LAB_ID" "${TARGET_DIR}/setup.sh"
    fi
    echo ""
    if [ -f "${TARGET_DIR}/scenario.md" ]; then
      cat "${TARGET_DIR}/scenario.md"
    fi
    ;;
  show)
    LAB_ID="${2:-}"
    TARGET_DIR="$(find_lab_dir "$LAB_ID")"
    if [ -n "$TARGET_DIR" ] && [ -f "${TARGET_DIR}/scenario.md" ]; then
      cat "${TARGET_DIR}/scenario.md"
    else
      echo -e "${RED}[ERROR] Scenario for ${LAB_ID} not found.${NC}"
    fi
    ;;
  check|verify|grade)
    LAB_ID="${2:-}"
    if [ -z "$LAB_ID" ]; then
      echo -e "${RED}[ERROR] Missing lab-id.${NC} Example: ./lab check w1d1-lfcs"
      exit 1
    fi
    TARGET_DIR="$(find_lab_dir "$LAB_ID")"
    if [ -z "$TARGET_DIR" ] || [ ! -f "${TARGET_DIR}/verify.sh" ]; then
      echo -e "${RED}[ERROR] Verification script for ${LAB_ID} not found.${NC}"
      exit 1
    fi
    echo -e "${CYAN}[*] Grading LFCS scenario ${BOLD}${LAB_ID}${NC} on VM..."
    execute_lab_script "$LAB_ID" "${TARGET_DIR}/verify.sh"
    ;;
  solve|solution)
    LAB_ID="${2:-}"
    TARGET_DIR="$(find_lab_dir "$LAB_ID")"
    if [ -n "$TARGET_DIR" ] && [ -f "${TARGET_DIR}/solution.md" ]; then
      cat "${TARGET_DIR}/solution.md"
    else
      echo -e "${RED}[ERROR] Solution for ${LAB_ID} not found.${NC}"
    fi
    ;;
  reset|clean)
    LAB_ID="${2:-}"
    TARGET_DIR="$(find_lab_dir "$LAB_ID")"
    if [ -n "$TARGET_DIR" ] && [ -f "${TARGET_DIR}/reset.sh" ]; then
      execute_lab_script "$LAB_ID" "${TARGET_DIR}/reset.sh"
      echo -e "${GREEN}[✓] Cleaned up ${LAB_ID} on VM.${NC}"
    else
      echo "No custom reset script found for ${LAB_ID}."
    fi
    ;;
  vm)
    vm_manager "${2:-status}"
    ;;
  ssh)
    shift || true
    ssh_shortcut "$@"
    ;;
  guide)
    shift || true
    if [ "$#" -eq 0 ]; then
      python3 "${SCRIPT_DIR}/generate_guides.py" "w1d1"
    else
      python3 "${SCRIPT_DIR}/generate_guides.py" "$@"
    fi
    ;;
  exam|simulator)
    shift || true
    bash "${SCRIPT_DIR}/webapp/start.sh"
    ;;
  calendar|schedule)
    shift || true
    python3 "${SCRIPT_DIR}/generate_calendar.py" "$@"
    ;;
  todo)
    shift || true
    python3 "${SCRIPT_DIR}/study_todo.py" "$@"
    ;;
  help|*)
    usage
    ;;
esac
